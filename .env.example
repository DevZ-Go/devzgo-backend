# Copy to .env (git-ignored). Used by local runs and by docker compose.
# Never commit a real .env with production secrets.

# Database. Leave commented to use local Postgres (docker compose "db" container, or localhost outside Docker).
# For the shared Neon database, paste the pooled connection string from the Neon console, keeping
# ?sslmode=require (and &channel_binding=require if Neon includes it):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-me-in-local-dev

# Transactional email via Resend (https://resend.com). Production must set RESEND_API_KEY or SMTP_*.
# Without either, the API logs that email was skipped — never OTP codes or reset tokens.
RESEND_API_KEY=
EMAIL_FROM=DevZ-Go <onboarding@resend.dev>
# Or send through any SMTP server (takes priority over Resend when SMTP_HOST is set).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address, SMTP_PASSWORD=an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# HMAC pepper for email OTP codes (falls back to SECRET_KEY). Set a dedicated value in production.
# EMAIL_OTP_PEPPER=
# Email/password register: pending row + OTP until verified. Existing accounts stay verified.
# Explicit true/false wins. If unset, production FRONTEND_URL requires OTP; localhost does not.
# REQUIRE_EMAIL_VERIFICATION=true

# Resend delivery webhooks (Svix-style). Without this, POST /webhooks/resend rejects all payloads.
# RESEND_WEBHOOK_SECRET=whsec_...
# Email worker (separate Render worker): python -m app.worker.email_worker
# EMAIL_WORKER_POLL_SECONDS=2
# EMAIL_WORKER_BATCH=20
# EMAIL_WORKER_LEASE_SECONDS=60

# Production: Cloudflare Pages origin (no trailing slash). Used for CORS, reset links, OAuth redirects.
FRONTEND_URL=http://localhost:5173
# Optional extra CORS origins (comma-separated). Default regex also allows *.pages.dev.
# CORS_ORIGINS=https://devz-go.pages.dev
# CORS_ORIGIN_REGEX=

# GitHub login: GitHub > Settings > Developer settings > OAuth Apps > New.
# Homepage = FRONTEND_URL, callback = <BACKEND_URL>/auth/github/callback
BACKEND_URL=http://localhost:8000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App for commits and pull requests (user-to-server). Separate from the login OAuth app above.
# Callback: <BACKEND_URL>/github/app/callback. Permissions: Contents and Pull requests read/write, Metadata read.
# Turn on expiring user tokens and "Request user authorization (OAuth) during installation". No webhook, no private key.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Fernet key for stored GitHub tokens. Either name works; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
WORKSPACE_TOKEN_KEY=

# Never enable on production Neon: allows POST /network/seed-demo to insert demo users and content.
# ALLOW_DEMO_SEED=true

# File storage: "local" (storage/ folder) or "s3" (RustFS, Cloudflare R2, Backblaze B2, AWS S3).
# Production (R2): STORAGE_BACKEND=s3, S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# S3_PUBLIC_ENDPOINT_URL same or custom domain, S3_REGION=auto, bucket + R2 API tokens.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=devzgo
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=devzgo
S3_SECRET_ACCESS_KEY=devzgo-secret

# Live messages/notifications across workers/instances. Without REDIS_URL the entrypoint forces
# one uvicorn worker; keep a single Render instance unless Redis is configured.
REDIS_URL=

# Shared/Neon: leave false. Apply migrations deliberately: alembic upgrade head
# (or a one-shot MIGRATE_ON_START=true). Never stamp or reset production.
# MIGRATE_ON_START=false
# FAIL_ON_SCHEMA_MISMATCH=true
# Tech stack catalog seed: local DBs default on; shared DBs need SEED_ON_START=true explicitly.
# SEED_ON_START=false

# The API stores finished Monthly Wraps every 6 hours. Set off to rely on `python -m app.scripts.generate_wraps` instead.
# WRAP_JOB=on

# Render sets PORT. Optional: UVICORN_WORKERS (only used when REDIS_URL is set).
# PORT=8000
# UVICORN_WORKERS=1

# Talent Intelligence feature flags (defaults shown). Numeric match stays off until validated.
# FEATURE_NUMERIC_MATCH=false
# FEATURE_CAREER=true
# FEATURE_RESUME_IMPORT=true
# FEATURE_BADGES=true
# FEATURE_RESUME_STUDIO=true
# Dev-only Resume Studio grants (comma-separated user UUIDs). Never enables payment collection.
# RESUME_STUDIO_DEV_GRANTS=
