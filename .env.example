# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
# Never commit a real .env with production secrets.

DATABASE_URL=postgresql://devzgo:devzgo@localhost:5432/devzgo_db
SECRET_KEY=change-me-in-local-dev

# File storage: "local" (storage/ folder) or "s3" (RustFS from docker compose, Cloudflare R2, Backblaze B2, AWS S3)
# Leave S3_ENDPOINT_URL empty to use the docker compose bucket; set it to the R2/B2 URL for the cloud bucket.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=devzgo
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=devzgo
S3_SECRET_ACCESS_KEY=devzgo-secret

# Docker only: point the container at a shared cloud Postgres (e.g. Neon) instead of the local db
# DOCKER_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
