# Copy to .env (git-ignored). Used by local runs and by docker compose.
# Never commit a real .env with production secrets.

# Database. Leave commented to use local Postgres (docker compose "db" container, or localhost outside Docker).
# For the shared Neon database, paste the pooled connection string from the Neon console, keeping
# ?sslmode=require (and &channel_binding=require if Neon includes it):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-me-in-local-dev

# Forgot-password email via Resend (https://resend.com). Leave the key empty locally: links go to the backend log.
# onboarding@resend.dev only delivers to your own Resend account email; verify a domain to email anyone.
RESEND_API_KEY=
EMAIL_FROM=DevZ-Go <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173

# GitHub login: GitHub > Settings > Developer settings > OAuth Apps > New.
# Homepage http://localhost:5173, callback http://localhost:8000/auth/github/callback
BACKEND_URL=http://localhost:8000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only enable on a throwaway database: allows POST /network/seed-demo to insert demo users and content.
# ALLOW_DEMO_SEED=true

# File storage: "local" (storage/ folder) or "s3" (RustFS from docker compose, Cloudflare R2, Backblaze B2, AWS S3)
# Leave S3_ENDPOINT_URL empty to use the docker compose bucket; set it to the R2/B2 URL for the cloud bucket.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=devzgo
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=devzgo
S3_SECRET_ACCESS_KEY=devzgo-secret
