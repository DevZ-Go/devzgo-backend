# Copy to .env (git-ignored). Used by local runs and by docker compose.
# Never commit a real .env with production secrets.

# Database. Leave commented to use local Postgres (docker compose "db" container, or localhost outside Docker).
# For the shared Neon database, paste the pooled connection string from the Neon console, keeping
# ?sslmode=require (and &channel_binding=require if Neon includes it):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-me-in-local-dev

# Forgot-password email via Resend (https://resend.com). Leave the key empty locally: links go to the backend log.
# onboarding@resend.dev only delivers to your own Resend account email; verify a domain to email anyone.
RESEND_API_KEY=
EMAIL_FROM=DevZ-Go <onboarding@resend.dev>
# Or send through any SMTP server (takes priority over Resend when SMTP_HOST is set).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address, SMTP_PASSWORD=an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:5173

# GitHub login: GitHub > Settings > Developer settings > OAuth Apps > New.
# Homepage http://localhost:5173, callback http://localhost:8000/auth/github/callback
BACKEND_URL=http://localhost:8000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App for commits and pull requests (user-to-server). Separate from the login OAuth app above.
# Callback: <BACKEND_URL>/github/app/callback. Permissions: Contents and Pull requests read/write, Metadata read.
# Turn on expiring user tokens and "Request user authorization (OAuth) during installation". No webhook, no private key.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Fernet key for stored GitHub tokens. Either name works; generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
WORKSPACE_TOKEN_KEY=

# Only enable on a throwaway database: allows POST /network/seed-demo to insert demo users and content.
# ALLOW_DEMO_SEED=true

# File storage: "local" (storage/ folder) or "s3" (RustFS from docker compose, Cloudflare R2, Backblaze B2, AWS S3)
# Leave S3_ENDPOINT_URL empty to use the docker compose bucket; set it to the R2/B2 URL for the cloud bucket.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=devzgo
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=devzgo
S3_SECRET_ACCESS_KEY=devzgo-secret

# Set true to apply pending Alembic migrations on startup against a shared database (local databases always migrate).
# MIGRATE_ON_START=false

# The API stores finished Monthly Wraps every 6 hours. Set off to rely on `python -m app.scripts.generate_wraps` instead.
# WRAP_JOB=on
